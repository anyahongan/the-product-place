# =============================================================================
# Browser-safe (Vite inlines VITE_* into the client bundle)
# Use ONLY the project URL + publishable/anon key here.
# =============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# =============================================================================
# SERVER ONLY — NEVER prefix with VITE_
# Required for local TanStack server ingestion (ingestGitHubJobsFn / CatalogIngestButton).
# NOT required for catalog reads, auth, or personal data (those use the publishable key + RLS).
#
# The service-role key BYPASSES Row Level Security. Never:
#   - put it in client components
#   - import serviceClient.server into browser modules
#   - log it, hardcode it, or commit real values to Git
#
# Deployed Supabase Edge Functions do NOT read this file — set secrets with:
#   npx supabase secrets set SUPABASE_SERVICE_ROLE_KEY=...
# =============================================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
